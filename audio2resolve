#!/usr/bin/env bash
# audio2resolve: converts audio (m4a, mp3, opus, aac...) to PCM WAV that
# DaVinci Resolve on Linux imports without trouble.
#
# Usage:
#   audio2resolve file.m4a [other.mp3 ...]
#   audio2resolve folder/             # converts all the audio in the folder
#   audio2resolve something.zip       # unzips and converts whatever is inside
#
# Options:
#   -o DIR    output folder (default: ./wav_resolve next to the input)
#   -b 16|24|32   bit depth (default 24)
#   -r HZ     sample rate (default: the original's)
#   -s        force stereo (default: keep the original channels)
#   -n        normalize to -16 LUFS (loudnorm, handy for voice)
#   -f        overwrite the WAV if it already exists
#   -h        this help

set -euo pipefail

BITS=24
RATE=""
OUTDIR=""
STEREO=0
NORM=0
FORCE=0

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while getopts "o:b:r:snfh" opt; do
  case "$opt" in
    o) OUTDIR="$OPTARG" ;;
    b) BITS="$OPTARG" ;;
    r) RATE="$OPTARG" ;;
    s) STEREO=1 ;;
    n) NORM=1 ;;
    f) FORCE=1 ;;
    h) usage 0 ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))

[ $# -eq 0 ] && usage 1
command -v ffmpeg >/dev/null || { echo "ffmpeg is missing" >&2; exit 1; }

case "$BITS" in
  16) CODEC=pcm_s16le ;;
  24) CODEC=pcm_s24le ;;
  32) CODEC=pcm_s32le ;;
  *)  echo "Bits must be 16, 24 or 32" >&2; exit 1 ;;
esac

EXTS="m4a mp3 aac opus ogg oga wma flac wav aiff aif mp4 mov mkv webm"
is_audio() {
  local e="${1##*.}"
  e="$(printf '%s' "$e" | tr 'A-Z' 'a-z')"
  case " $EXTS " in *" $e "*) return 0 ;; *) return 1 ;; esac
}

TMPDIRS=()
cleanup() { for d in "${TMPDIRS[@]:-}"; do if [ -n "$d" ]; then rm -rf "$d"; fi; done; }
trap cleanup EXIT

FILES=()
DEFAULT_OUT=""

add_dir() {
  local dir="$1"
  while IFS= read -r -d '' f; do
    is_audio "$f" && FILES+=("$f")
  done < <(find "$dir" -maxdepth 1 -type f -print0 | sort -z)
}

for arg in "$@"; do
  if [ -d "$arg" ]; then
    [ -z "$DEFAULT_OUT" ] && DEFAULT_OUT="${arg%/}/wav_resolve"
    add_dir "$arg"
  elif [ -f "$arg" ] && [ "${arg##*.}" = "zip" -o "${arg##*.}" = "ZIP" ]; then
    tmp="$(mktemp -d)"; TMPDIRS+=("$tmp")
    unzip -o -q -j "$arg" -d "$tmp"
    [ -z "$DEFAULT_OUT" ] && DEFAULT_OUT="$(dirname "$arg")/wav_resolve"
    add_dir "$tmp"
  elif [ -f "$arg" ]; then
    [ -z "$DEFAULT_OUT" ] && DEFAULT_OUT="$(dirname "$arg")/wav_resolve"
    FILES+=("$arg")
  else
    echo "Not found: $arg" >&2; exit 1
  fi
done

[ ${#FILES[@]} -eq 0 ] && { echo "No audio files found to convert." >&2; exit 1; }

OUTDIR="${OUTDIR:-$DEFAULT_OUT}"
mkdir -p "$OUTDIR"

ok=0; skip=0; fail=0
for f in "${FILES[@]}"; do
  base="$(basename "$f")"
  out="$OUTDIR/${base%.*}.wav"

  if [ -e "$out" ] && [ "$FORCE" -eq 0 ]; then
    echo "· already exists, skipping: $(basename "$out")  (use -f to redo it)"
    skip=$((skip + 1)); continue
  fi

  args=(-hide_banner -loglevel error -y -i "$f" -vn -map a:0 -c:a "$CODEC")
  [ -n "$RATE" ] && args+=(-ar "$RATE")
  [ "$STEREO" -eq 1 ] && args+=(-ac 2)
  [ "$NORM" -eq 1 ] && args+=(-af "loudnorm=I=-16:TP=-1.5:LRA=11")
  args+=(-rf64 auto "$out")

  if ffmpeg "${args[@]}"; then
    printf '✓ %s → %s\n' "$base" "$(basename "$out")"
    ok=$((ok + 1))
  else
    echo "✗ failed: $base" >&2
    fail=$((fail + 1))
  fi
done

echo
echo "Done: $ok converted, $skip skipped, $fail failed"
echo "Folder: $OUTDIR"
[ "$fail" -eq 0 ] || exit 1
